# Environment variables for Word Memory Backend

# PostgreSQL configuration (used by Docker Compose & Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=wordmemory

# Database connection string
DATABASE_URL="postgresql://postgres:change_this_to_a_strong_password@db:5432/wordmemory?schema=public"

# Server Port
PORT=3001
